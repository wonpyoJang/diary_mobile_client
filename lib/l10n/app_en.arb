  "emotion_warmth_name": "Warmth",
  "emotion_warmth_explanation": "A warm and cozy feeling, like being wrapped in a blanket on a winter day.\n\nOften experienced through closeness and love.",
  "emotion_happiness_name": "Happiness",
  "emotion_happiness_explanation": "A state of joy and satisfaction, felt in small moments and achievements.\n\nBrings positive energy and improves quality of life.",
  "emotion_calmness_name": "Calmness",
  "emotion_calmness_explanation": "A peaceful and stable state, free from noise and stress.\n\nOften found in meditation or nature.",
  "emotion_hope_name": "Hope",
  "emotion_hope_explanation": "A positive expectation for the future, giving strength to move forward even in difficult times.\n\nThe driving force of life.",
  "emotion_mystery_name": "Mystery",
  "emotion_mystery_explanation": "A sense of wonder and curiosity about the unknown.\n\nStimulates imagination and creativity.",
  "emotion_stability_name": "Stability",
  "emotion_stability_explanation": "A stable and unchanging state, felt when life is predictable and secure.\n\nProvides psychological safety and reduces stress.",
  "emotion_gentleness_name": "Gentleness",
  "emotion_gentleness_explanation": "A soft and kind feeling, experienced when being considerate and caring.\n\nSmooths relationships and increases understanding.",
  "emotion_freshness_name": "Freshness",
  "emotion_freshness_explanation": "A new and refreshing feeling, often felt at the start of something new or during change.\n\nBrings vitality to daily life.",
  "emotion_boredom_name": "Boredom",
  "emotion_boredom_explanation": "A state of disinterest and monotony, often felt in repetitive situations.\n\nCan motivate the search for new stimulation.",
  "emotion_anger_name": "Anger",
  "emotion_anger_explanation": "A state of rage, often felt in unfair situations.\n\nSometimes a strong motivator for change.",
  "emotion_excitement_name": "Excitement",
  "emotion_excitement_explanation": "A lively and energetic state, felt before special events or achievements.\n\nBoosts energy and positive actions.",
  "emotion_sadness_name": "Sadness",
  "emotion_sadness_explanation": "A state of pain and depression, felt after loss or disappointment.\n\nHelps deepen empathy and understanding.",
  "emotion_fear_name": "Fear",
  "emotion_fear_explanation": "A feeling of anxiety and threat, experienced when sensing danger.\n\nHelps survival and avoiding risks.",
  "emotion_surprise_name": "Surprise",
  "emotion_surprise_explanation": "A reaction to the unexpected, felt instantly in both positive and negative events.\n\nIncreases focus and learning.",
  "emotion_disgust_name": "Disgust",
  "emotion_disgust_explanation": "A feeling of dislike and discomfort, a reaction to unpleasant situations or substances.\n\nInstinctive for health and safety.",
  "emotion_love_name": "Love",
  "emotion_love_explanation": "A deep feeling of affection and attachment, experienced in close relationships.\n\nStrengthens bonds and gives meaning to life.",
  "emotion_pride_name": "Pride",
  "emotion_pride_explanation": "A positive sense of self, felt through achievement or ability.\n\nIncreases confidence and encourages challenge.",
  "emotion_shame_name": "Shame",
  "emotion_shame_explanation": "A feeling of embarrassment, experienced when violating social norms.\n\nPromotes reflection and improvement.",
  "emotion_guilt_name": "Guilt",
  "emotion_guilt_explanation": "A feeling of regret and responsibility for wrongdoing.\n\nEncourages moral reflection and relationship recovery.",
  "emotion_envy_name": "Envy",
  "emotion_envy_explanation": "A desire for what others have, felt when admiring others' success or possessions.\n\nCan be a source of motivation.",
  "emotion_jealousy_name": "Jealousy",
  "emotion_jealousy_explanation": "A fear of losing something precious to others' success or happiness.\n\nInstinctive for protecting relationships.",
  "emotion_contentment_name": "Contentment",
  "emotion_contentment_explanation": "A sense of satisfaction with the present, felt when life is balanced and harmonious.\n\nProvides psychological stability and reduces stress.",
  "emotion_gratitude_name": "Gratitude",
  "emotion_gratitude_explanation": "A feeling of thankfulness, experienced for others' help or kindness.\n\nBuilds positive relationships and increases happiness.",
  "emotion_nostalgia_name": "Nostalgia",
  "emotion_nostalgia_explanation": "A longing for the past, felt when recalling childhood or special moments.\n\nCherishes past experiences and enriches the present.",
  "emotion_loneliness_name": "Loneliness",
  "emotion_loneliness_explanation": "A feeling of being alone and isolated, experienced when lacking social connection.\n\nReminds the importance of relationships and motivates new connections.",
  "emotion_frustration_name": "Frustration",
  "emotion_frustration_explanation": "A feeling of disappointment from not reaching a goal.\n\nMotivates new strategies and growth.",
  "emotion_awe_name": "Awe",
  "emotion_awe_explanation": "A sense of wonder at greatness, felt in nature or human achievements.\n\nInspires humility and creativity.",
  "emotion_amusement_name": "Amusement",
  "emotion_amusement_explanation": "A state of fun and enjoyment, felt through humor or entertainment.\n\nRelieves stress and provides positive energy.",
  "emotion_relief_name": "Relief",
  "emotion_relief_explanation": "A state of comfort after worry disappears, felt when tension is resolved.\n\nBrings psychological stability and positive change.",
  "emotion_curiosity_name": "Curiosity",
  "emotion_curiosity_explanation": "An interest in new things, a desire to explore the unknown.\n\nDrives learning and discovery.",
  "emotion_desire_name": "Desire",
  "emotion_desire_explanation": "A strong wish for something, motivating progress toward goals.\n\nPromotes achievement and growth.",
  "emotion_confusion_name": "Confusion",
  "emotion_confusion_explanation": "A state of uncertainty, felt when information is unclear or contradictory.\n\nMotivates new approaches to problem-solving.",
  "emotion_doubt_name": "Doubt",
  "emotion_doubt_explanation": "A feeling of uncertainty, experienced when facing unreliable situations.\n\nIncreases focus and logical thinking.",
  "emotion_comfort_name": "Comfort",
  "emotion_comfort_explanation": "A state of comfort and stability, felt when free from stress and worry.\n\nProvides psychological stability and improves quality of life.",
  "emotion_joy_name": "Joy",
  "emotion_joy_explanation": "A state of happiness and delight, felt through good events or achievements.\n\nBrings positive energy and vitality.",
  "emotion_affection_name": "Affection",
  "emotion_affection_explanation": "A deep feeling of fondness and attachment, experienced in close relationships.\n\nStrengthens bonds and gives meaning to life.",
  "emotion_excitementNew_name": "Thrill",
  "emotion_excitementNew_explanation": "A lively and energetic state, felt before special events or achievements.\n\nBoosts energy and positive actions.",
  "emotion_anxiety_name": "Anxiety",
  "emotion_anxiety_explanation": "A feeling of fear and unease, experienced when sensing danger or threat.\n\nHelps survival and avoiding risks.",
  "emotion_tension_name": "Tension",
  "emotion_tension_explanation": "A state of nervousness and anxiety, felt when facing important tasks or challenges.\n\nIncreases focus and problem-solving.",
  "emotion_depression_name": "Depression",
  "emotion_depression_explanation": "A state of pain and depression, felt after loss or disappointment.\n\nHelps deepen empathy and understanding.",
