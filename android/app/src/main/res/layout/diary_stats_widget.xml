<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stats_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/stats_streak_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="연속 기록"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_streak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0일"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_today_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="오늘의 감정"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_today"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="—"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/stats_week_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="이번 주 (건수)"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stats_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="4"
        android:text="—"
        android:textSize="11sp" />
</LinearLayout>
